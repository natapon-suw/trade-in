DATABASE_URL=mysql://user:password@localhost:3306/tradein
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h
PORT=3000
UPLOAD_PATH=./uploads
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins (API)
CORS_ORIGINS=http://localhost:4200

# Backend API URL used by Next.js server-side rewrites (Web)
API_URL=http://localhost:3000

# Public API URL used by browser-side fetch calls (Web)
# For subdomain deployment, set to: https://api.yourdomain.com/api
# NEXT_PUBLIC_API_URL=/api
