{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project web --web",
  "targets": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production", { "externalDependencies": ["next"] }],
      "outputs": ["{projectRoot}/.next/!(cache)/**/*", "{projectRoot}/.next/!(cache)"],
      "options": {
        "cwd": "apps/web",
        "command": "npx cross-env NODE_ENV=production next build"
      },
      "executor": "nx:run-commands"
    },
    "serve": {
      "continuous": true,
      "options": {
        "cwd": "apps/web",
        "command": "next dev --port 4200"
      },
      "executor": "nx:run-commands"
    },
    "dev": {
      "continuous": true,
      "options": {
        "cwd": "apps/web",
        "command": "next dev --port 4200"
      },
      "executor": "nx:run-commands"
    },
    "start": {
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/web",
        "command": "next start"
      },
      "executor": "nx:run-commands"
    }
  }
}
